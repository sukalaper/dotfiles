#!/bin/bash

style=$(cat $HOME/.config/dunst/sid)

if pgrep -x "pulseaudio" > /dev/null; then
  if [[ "$style" == "Light" ]]; then
    pactl set-sink-volume @DEFAULT_SINK@ +5% && notify-send "Volume Up: $(pactl list sinks | grep -m 1 'Volume' | awk '{print $5}')"
  else
    pactl set-sink-volume @DEFAULT_SINK@ +5% && notify-send "Volume Up: $(pactl list sinks | grep -m 1 'Volume' | awk '{print $5}')"
  fi
else
  if [[ "$style" == "Light" ]]; then
    amixer -Mq set Master,0 5%+ unmute && notify-send "Volume Up: $(amixer get Master | grep -oP '[0-9]{1,3}%')"
  else
    amixer -Mq set Master,0 5%+ unmute && notify-send "Volume Up: $(amixer get Master | grep -oP '[0-9]{1,3}%')"
  fi
fi
